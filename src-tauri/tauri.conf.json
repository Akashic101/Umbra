{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Umbra",
	"version": "0.0.1",
	"identifier": "app.umbra",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Umbra",
				"width": 1280,
				"height": 800,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost https://api.open-meteo.com https://archive-api.open-meteo.com https://nominatim.openstreetmap.org; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"entitlements": "entitlements.plist",
			"minimumSystemVersion": "10.15"
		},
		"iOS": {
			"minimumSystemVersion": "14.0"
		},
		"android": {
			"minSdkVersion": 24,
			"debugApplicationIdSuffix": ".debug"
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["umbra"]
			},
			"mobile": [
				{
					"scheme": ["umbra"],
					"appLink": false
				}
			]
		}
	}
}
