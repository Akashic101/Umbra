{
	"name": "umbra",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run",
		"test:coverage": "bun run test:unit -- --coverage",
		"knip": "knip",
		"import:lunar": "bun scripts/import-lunar-catalog.ts",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/cli": "^2.11.4",
		"@types/leaflet": "^1.9.22",
		"@vitest/coverage-v8": "4.1.10",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"knip": "^6.32.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@astronomy-bundle/core": "^9.38.0",
		"@astronomy-bundle/solar-eclipse": "^9.38.0",
		"@inlang/paraglide-js": "^2.24.0",
		"@tauri-apps/plugin-deep-link": "^2.4.9",
		"@tauri-apps/plugin-geolocation": "^2.3.2",
		"@tauri-apps/plugin-http": "^2.5.9",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"astronomy-engine": "^2.1.19",
		"leaflet": "^1.9.4"
	}
}
